{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "material-picker",
	"main": "./worker.mjs",
	"compatibility_date": "2026-09-23",
	"observability": {
		"enabled": true
	},
	"browser": {
		"binding": "BROWSER"
	},
	"ai": {
		"binding": "AI"
	},
	"previews": {
		"browser": {
			"binding": "BROWSER"
		},
		"ai": {
			"binding": "AI"
		}
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "picker_accounts",
			"database_name": "picker-accounts",
			"database_id": "80db8024-fa41-4b79-ba96-9b4a3558c89c"
		}
	]
}