{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "material-picker",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
