# Baseline Environment Variables
# Copy this file to .env and configure secrets as needed.

# Application Keys
# API_KEY=your_key_here

# Google OAuth for Picker accounts and YouTube subscriptions.
# Register both redirect URIs in Google Cloud:
# http://localhost:4173/api/auth/google/callback
# https://picker.rynell.org/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
