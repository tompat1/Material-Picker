{
  "name": "material-picker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development node --watch --watch-path=./public --watch-path=./video-chapters.mjs --watch-path=./video-search.mjs server.js",
    "build": "npm test && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "preview": "wrangler dev",
    "start": "NODE_ENV=production node server.js",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:live": "node tests/verify-live.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "wrangler": "4.136.3"
  }
}
